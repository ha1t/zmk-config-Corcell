DT_COMPAT_CORCELL_BATTERY_VOLTAGE_DIVIDER := corcell,battery-voltage-divider

config CORCELL_BATTERY_VOLTAGE_DIVIDER
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_CORCELL_BATTERY_VOLTAGE_DIVIDER))
    select ADC
    select ZMK_BATTERY
    depends on SENSOR
    help
        Enable Corcell dry-cell voltage divider battery monitoring.
